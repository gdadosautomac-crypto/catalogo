    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select * from (\n\tselect \n\t\ty.data_pedido,\n\t\ty.cod_cliente,\n\t\ty.nome_cliente,\n\t\ty.cod_pedido,\n\t\ty.categoria_produto,\n\t\ty.classe_produto,\n\t\ty.sub_classe_produto,\n\t\ty.nome_produto,\n\t\tY.qtd_produto as Qtd_produto,\n\t\tcoalesce(qtd_entregue,0) as qtd_entregue,\n\t\t(y.qtd_produto - coalesce(qtd_entregue,0)) as Pendentes\n\tfrom (\n\t\tselect \n\t\t\tunidade,\n\t\t\tcod_cliente,\n\t\t\tnome_cliente,\n\t\t\tcod_pedido,\n\t\t\tp.cod_produto,\n\t\t\tdata_pedido::Date,\n\t\t\tstatus_pedido,\n\t\t\tcategoria_produto,\n\t\t\tclasse_produto,\n\t\t\tsub_classe_produto,\n\t\t\tnome_produto,\n\t\t\tROUND(sum(replace(qtd_produto,',','.')::numeric),2) as Qtd_Produto\n\t\tfrom pedidos p \n\t\t\tleft join coes c on p.coes = c.nome \n\t\twhere \n\t\t\tc.gerafaturamento = 'SIM' and p.unidade = 'VITORIA DE SANTO ANTAO' and p.status_pedido in ('Em Separacao', 'Em Producao', 'Aberto')\n\t\tgroup by unidade, cod_cliente, nome_cliente, cod_pedido, p.cod_produto, data_pedido::Date, status_pedido, categoria_produto, classe_produto,\n\t\tsub_classe_produto, nome_produto\n\t) y \n\t\tleft join (\n\t\t\tselect \n\t\t\t\tunidade, \n\t\t\t\tcod_cliente, \n\t\t\t\tcod_pedido, \n\t\t\t\tcod_produto, \n\t\t\t\tcategoria_produto, \n\t\t\t\tclasse_produto, \n\t\t\t\tsub_classe_produto, \n\t\t\t\tnome_produto, \n\t\t\t\tROUND(SUM(qtd_entregue),2) as QTD_ENTREGUE\n\t\t\tfrom entregas_geral eg \n\t\t\twhere unidade = 'VITORIA DE SANTO ANTAO'\n\t\t\tgroup by unidade, cod_cliente, COD_PEDIDO, cod_produto, categoria_produto, classe_produto, sub_classe_produto, nome_produto\n\t\t) x on x.unidade = y.unidade and x.categoria_produto = y.categoria_produto and x.classe_produto = y.classe_produto \n\t\tand x.sub_classe_produto = y.sub_classe_produto and x.nome_produto = y.nome_produto and x.cod_produto = y.cod_produto and x.cod_pedido = y.cod_pedido\n) c where pendentes <> 0 and COD_CLIENTE in ('721', '1009', '1050', '1063', '1151', '1315', '1354', '1447', '1462')  and categoria_produto not like ('%TEMPERADO%')\norder by data_pedido::Date asc, cod_cliente desc, cod_pedido asc, nome_produto asc",
        "options": {}
      },
