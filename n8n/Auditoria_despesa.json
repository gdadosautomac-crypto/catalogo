        "jsCode": "const items = $input.all();\n\nitems.forEach(item => {\n  // Tratando o campo data_pagamento\n  if (item.json.data_pagamento) {\n    item.json.data_pagamento = new Date(item.json.data_pagamento).toISOString().split('T')[0];\n  }\n\n  // Tratando o campo data_emissao\n  if (item.json.data_emissao) {\n    item.json.data_emissao = new Date(item.json.data_emissao).toISOString().split('T')[0];\n  }\n\n  // Tratando o campo data_vencimento\n  if (item.json.data_vencimento) {\n    item.json.data_vencimento = new Date(item.json.data_vencimento).toISOString().split('T')[0];\n  }\n});\n\nreturn items;\n"
