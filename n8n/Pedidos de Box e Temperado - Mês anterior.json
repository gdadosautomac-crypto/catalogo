    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tnome_cliente as nome, \n\tcod_pedido as pedido,\n\tcase \n\t\twhen categoria_produto like '%TEMPERADO%' then 'TEMPERADO'\n\t\twhen categoria_produto like '%BOX%' then 'BOX'\n\tend categoria, \n\tclasse_produto as cor, \n\tsub_classe_produto as espessura, \n\tround(sum(valor_entregue + coalesce(acrescimo, 0) ), 2) as valor_expedido, \n\tROUND(sum(custo_entregue), 2) as custo_expedido, \n\tROUND(sum(replace(metragem_entregue, ',','.')::numeric), 2) as m2, \n\tround(abs(sum(custo_entregue) / nullif((sum(valor_entregue) - 1), 0)), 4) as Margem, \n\tround(sum(valor_entregue) / sum(replace(metragem_entregue,',','.')::numeric),4) as preco_venda_m2, \n\tcase \n\t\twhen date_part('MONTH', data_hora_entregue::date) = 1 then 'JANEIRO'\n\t\twhen date_part('MONTH', data_hora_entregue::date) = 2 then 'FEVEREIRO'\n\t\twhen date_part('MONTH', data_hora_entregue::date) = 3 then 'MARÇO'\n\t\twhen date_part('MONTH', data_hora_entregue::date) = 4 then 'ABRIL'\n\t\twhen date_part('MONTH', data_hora_entregue::date) = 5 then 'MAIO'\n\t\twhen date_part('MONTH', data_hora_entregue::date) = 6 then 'JUNHO'\n\t\twhen date_part('MONTH', data_hora_entregue::date) = 7 then 'JULHO' \n\t\twhen date_part('MONTH', data_hora_entregue::date) = 8 then 'AGOSTO' \n\t\twhen date_part('MONTH', data_hora_entregue::date) = 9 then 'SETEMBRO' \n\t\twhen date_part('MONTH', data_hora_entregue::date) = 10 then 'OTUBRO'\n\t\twhen date_part('MONTH', data_hora_entregue::date) = 11 then 'NOVEMBBRO'\n\t\twhen date_part('MONTH', data_hora_entregue::date) = 12 then 'DEZEMBRO'\n\tend as mes \nfrom entregas_geral eg \nwhere \n\tcategoria_produto in ('TEMPERADO','TEMPERADO ESPECIAL','BOX PADRÃO','BOX PADRÃO 1900') and unidade = 'VITORIA DE SANTO ANTAO'\n\tand data_hora_entregue::date between date_trunc('MONTH', current_date) - interval '1 MONTH' \n\tand date_trunc('MONTH', current_date) - interval '1 SECOND' \ngroup by nome_cliente, cod_pedido, categoria_produto, classe_produto, sub_classe_produto, date_part('MONTH', data_hora_entregue::date)",
        "options": {}
      },
