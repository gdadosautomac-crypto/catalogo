    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Clientes há de 90 sem comprar - Belga\n\nselect \n\tvendas.*, \n\tvendedor.vendedor \nfrom (\n\tselect \n\t\tp.unidade, \n\t\tp.nome_cliente, \n\t\tp.cod_cliente, \n\t\tmc.ramo_atividade, \n\t\tcategoria_produto, \n\t\tmax(cod_pedido) as ultimo_pedido, \n\t\t--max(data_pedido::date) as data_ultimo_ped, \n\t\tto_char(max(data_pedido::date), 'dd/mm/yyyy') as data_ultimo_ped, \n\t\tround(sum(replace(valor_unitario_total_com_desconto,',','.')::numeric),2) as valor_vendido, \n\t\tcount(distinct cod_pedido) as qtd_pedidos\n\tfrom pedidos p \n\t\tleft join coes c on p.coes = c.nome \n\t\tleft join mapeamento_clientes mc on mc.unidade = p.unidade and mc.codcliente = p.cod_cliente \n\twhere \n\t\tp.unidade in ('BELGA POLIMEROS') and c.gerafaturamento = 'SIM' and data_pedido::date >= '2023-01-01'\n\tgroup by p.unidade, p.nome_cliente, p.cod_cliente, categoria_produto, mc.ramo_atividade\n) vendas\n\tleft join (\n\t\tselect \n\t\t\tunidade,\n\t\t\tcod_pedido,\n\t\t\tvendedor \n\t\tfrom pedidos p \n\t\twhere \n\t\t\tunidade in ('BELGA POLIMEROS') \n\t\tgroup by unidade, cod_pedido, vendedor\n\t) vendedor on vendedor.unidade = vendas.unidade and vendedor.cod_pedido = vendas.ultimo_pedido\nwhere \n\tto_date(data_ultimo_ped, 'dd/mm/yyyy') <= NOW()::DATE - '90 DAY'::INTERVAL\norder by vendas.unidade, vendedor.vendedor, vendas.nome_cliente, vendas.categoria_produto",
        "options": {}
      },
