    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\teg.categoria_produto, \n\teg.classe_produto, \n\tround(sum(custo_entregue),2) as custo,\n\tround(sum(valor_entregue),2) as valor, \n\tround((sum(valor_entregue) - sum(custo_entregue))/sum(valor_entregue), 4) as Margem\nfrom entregas_geral eg \nwhere\n\tunidade = 'PERFILUX' and data_hora_entregue::date between to_char(now()::date, 'yyyy-mm-01')::date and current_date - 1\ngroup by eg.categoria_produto, eg.classe_produto",
