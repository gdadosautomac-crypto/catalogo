  "name": "Manu - Faturamento dos últimos 3 meses - Bodinhos",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tdate_part('month', data_hora_pedido::Date) as mes,\n\teg.unidade,\n\tcategoria_produto,\n\tROUND(SUM(eg.valor_entregue),2) as venda,\n\tROUND(SUM(eg.custo_entregue ),2) as custo\nfrom entregas_geral eg   \n\tleft join unidades u on eg.tipo_unidade = u.tipo_unidade and eg.unidade = u.unidade  \nwhere \n\teg.tipo_unidade = 'Bodinho' and matriz = 'VITORIA DE SANTO ANTAO' \n\tand data_hora_pedido::Date >= (to_char(NOW()::DATE, 'yyyy-mm-01')::date - '3 MONTH'::interval) \n\tAND ( eg.categoria_produto = 'SMART' OR (eg.categoria_produto = 'FERRAGEM' AND eg.classe_produto ILIKE '%POL%')\n)\ngroup by eg.unidade, categoria_produto, date_part('month', data_hora_pedido::Date)",
        "options": {}
      },
