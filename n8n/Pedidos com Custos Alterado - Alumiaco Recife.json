    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n'{{ $json.unidade }}' as Unidade,\nped.NU_PVE as Pedido,\nusu.NOM_USU as Usuario,\nh.DATA_REAJUSTE as DataReajuste,\npro.DS_PRO as Produto,\nh.CUSTO_ANTERIOR as CustoAnterior,\nh.NOVO_CUSTO as CustoNovo\nfrom historicoreajustecustopedidovenda h \nleft join mgpve01011 itens on itens.NU_PVE = h.NU_PVE and h.NU_DPV = itens.NU_DPV  \nleft join mgpve01010 ped on ped.NU_PVE = itens.NU_PVE \nleft join mgcli01010 cli on cli.NU_CLI = ped.NU_CLI \nleft join mgpro01010 pro on pro.NU_PRO = itens.NU_PRO\nleft join mgcat01010 cat on cat.NU_CAT = pro.NU_CAT\nleft join mgclp01010 cla on cla.NU_CLP = pro.NU_CLP \nleft join mgscp01010 sub on sub.NU_SCP = pro.NU_SCP \nleft join mgoes01010 coes on coes.NU_OES = ped.NU_OES  \nleft join mgusu01010 usu on usu.NU_USU = h.NU_USU \n  where h.DATA_REAJUSTE >= CURRENT_TIMESTAMP() - INTERVAL 3 HOUR  \ngroup by \nped.NU_PVE, h.DATA_REAJUSTE, usu.NOM_USU, pro.DS_PRO, h.CUSTO_ANTERIOR, h.NOVO_CUSTO\norder by h.data_reajuste desc ",
        "options": {}
      },
