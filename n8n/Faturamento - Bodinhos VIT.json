    {
      "parameters": {
        "operation": "executeQuery",
        "query": "(select \n\teg.unidade, \n\teg.categoria_produto, \n\tround(sum(valor_entregue),2) as valor\nfrom entregas_geral eg\nleft join unidades u on eg.unidade = u.unidade and eg.tipo_unidade = u.tipo_unidade \nwhere \n\tu.matriz = 'VITORIA DE SANTO ANTAO' and eg.tipo_unidade = 'Bodinho'\n\tand data_hora_entregue::date >= to_char(now()::date, 'yyyy-mm-01')::date\n\tand (eg.categoria_produto like '%CHAPARIA%' or eg.categoria_produto = 'FERRAGEM')\ngroup by eg.unidade, eg.categoria_produto\n) union all (\nselect \n\teg.unidade, \n\t'FATURAMENTO TOTAL',\n\tround(sum(valor_entregue),2) as valor\nfrom entregas_geral eg\nleft join unidades u on eg.unidade = u.unidade and eg.tipo_unidade = u.tipo_unidade \nwhere \n\tu.matriz = 'VITORIA DE SANTO ANTAO' and eg.tipo_unidade = 'Bodinho'\n\tand data_hora_entregue::date >= to_char(now()::date, 'yyyy-mm-01')::date\ngroup by eg.unidade)",
        "options": {}
      },
