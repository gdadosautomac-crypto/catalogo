      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT *,\n       ROUND((1 - (CAST(REPLACE(valor_liquido_final, ',', '.') AS NUMERIC) / CAST(REPLACE(valor_bruto, ',', '.') AS NUMERIC))) * 100, 2) AS taxa_dsf\nFROM valores_dsf vd\nWHERE DATE(data_dsf ::timestamp) = current_date - 1\n  AND (1 - (CAST(REPLACE(valor_liquido_final, ',', '.') AS NUMERIC) / CAST(REPLACE(valor_bruto, ',', '.') AS NUMERIC))) * 100 >= 9;",
