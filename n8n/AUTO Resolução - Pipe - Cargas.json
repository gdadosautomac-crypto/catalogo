      "id": "1dd6d52c-10ae-4f56-bb5a-d68e8e91e374",
      "name": "Extrair Cards"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  eg.unidade,\n  eg.cod_romaneio,\n  SUM(eg.valor_entregue)::numeric as valor_entregue,\n  MAX(spp.totalpago)::numeric as totalpago\nFROM entregas_geral eg\nLEFT JOIN status_pagamento_pedidos spp \n  ON eg.unidade = spp.unidade \n  AND eg.cod_pedido = spp.cod_pedido\nWHERE eg.unidade = '{{ $json.unidade }}' \n  AND eg.cod_romaneio = '{{ $json.romaneio }}'\nGROUP BY eg.unidade, eg.cod_romaneio",
        "options": {}
      },
