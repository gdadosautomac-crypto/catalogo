    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst response = $input.first().json.data?.cards;\n\nif (!response) {\n  return [];\n}\n\n// Atualiza paginação\nstaticData.cursor = response.pageInfo.endCursor;\nstaticData.hasNextPage = response.pageInfo.hasNextPage;\n\nconst cards = response.edges\n  .map(edge => {\n    const fields = edge.node.fields;\n    const romaneio = fields.find(f => f.name === 'Romaneio')?.value || null;\n    const unidade = fields.find(f => f.name === 'Unidade')?.value || null;\n\n    return {\n      card_id: edge.node.id,\n      phase_id: edge.node.current_phase.id,\n      phase_name: edge.node.current_phase.name,\n      romaneio,\n      unidade\n    };\n  })\n  .filter(c => c.phase_name !== 'Resolvido');\n\nreturn cards.map(c => ({ json: c }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        -304
