        "jsCode": "return items.map(item => {\n  const dataEmissao = item.json.data_emissao;\n  const dataVencimento = item.json.data_vencimento;\n\n  if (dataEmissao) {\n    item.json.data_emissao = new Date(dataEmissao).toISOString().slice(0, 10);\n  }\n\n  if (dataVencimento) {\n    item.json.data_vencimento = new Date(dataVencimento).toISOString().slice(0, 10);\n  }\n\n  return item;\n});\n"
