    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const body = item.json.body || {};\n\n  const numeroOriginal = body.contato || \"\";\n  const numeroLimpo = numeroOriginal.replace(/[^0-9]/g, \"\");\n\n  const dataOriginal = body.Data || \"\"; // YYYY-MM-DD\n  let dataFormatada = \"\";\n\n  if (dataOriginal) {\n    const [ano, mes, dia] = dataOriginal.split(\"-\");\n    dataFormatada = `${dia}-${mes}-${ano}`;\n  }\n\n  return {\n    json: {\n      ...item.json,\n      body: {\n        ...body,\n        telefoneFormatado: numeroLimpo,\n        Data: dataFormatada\n      }\n    }\n  };\n});\n"
      },
