    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tunidade, \n    cod_pedido, \n    cod_cliente, \n    nome_cliente, \n    cod_produto, \n    nome_produto, \n\tround(valor/qtd, 2) as vlr_uni, \n    round(custo/qtd, 2) as cst_uni, \n\tCONCAT(ROUND(abs(custo/valor - 1) * 100,2),' ','%') as margem, \n\tvendedor\nfrom ( \n\tselect \n\t\tunidade, \n\t\tcod_pedido, \n        cod_cliente, \n        nome_cliente, \n\t\tcod_produto, \n\t\tnome_produto, \n\t\tround(sum(replace(valor_unitario_total_com_desconto, ',','.')::numeric), 2) as valor, \n\t\tround(sum(replace(custo_unitario_total_produto, ',','.')::numeric), 2) as custo, \n\t\tround(sum(replace(qtd_produto, ',','.')::numeric), 2) as qtd,\n\t\tvendedor\n\tfrom pedidos p \n\twhere \n\t\tunidade = 'BELGA POLIMEROS' \n        and data_hora_pedido::TIMESTAMP >= NOW()::TIMESTAMP - '1 HOUR'::interval\n\t\t--and data_hora_pedido::date >= '2026-01-01' \n\tgroup by unidade, cod_pedido, cod_produto, nome_produto, vendedor, nome_cliente, cod_cliente\n) x where CONCAT(ROUND(abs(custo/valor - 1) * 100,2),' ','%') < '40.00'",
        "options": {}
      },
