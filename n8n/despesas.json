    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Despesas bodinhos\nSELECT \n    mf.tipo_unidade,\n    mf.unidade,\n    mf.chave as titulo,\n    mf.tipo_de_lancamento,\n    TO_CHAR(TO_DATE(mf.data_pagamento, 'YYYY/MM/DD'), 'YYYY-MM-DD') AS data_pagamento, -- Retorna apenas a data sem hora\n    mf.plano_conta,\n    mf.centro_custo,\n    mf.nome_conta,\n    mf.classificacao,\n    mf.descricao,\n    ROUND(CAST(REPLACE(mf.vlr_pago, ',', '.') AS NUMERIC), 2) AS vlr_pago -- Aplica ROUND ao valor pago\nFROM  \n    movimentacoes_financeiras mf \nWHERE \n    TO_DATE(mf.data_pagamento, 'YYYY/MM/DD') BETWEEN CURRENT_DATE - INTERVAL '8 day' AND CURRENT_DATE\n    AND mf.tipo_de_lancamento = 'Saida'\nORDER BY \n    mf.unidade;\n",
        "options": {}
      },
