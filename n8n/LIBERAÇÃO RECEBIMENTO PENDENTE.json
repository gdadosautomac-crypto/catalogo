    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\ttipo_unidade, \n\tunidade,\n\tnome_cliente,\n\ttipo_documento,\n\tNU_DOCUMENTO,\n\tTO_CHAR(data_vencimento::DATE,'YYYY-MM-DD'),\n\treplace(valor_titulo,',','.')::numeric as Valor\nfrom painel_financeiro pf \nwhere tipo_documento in ('boleto', 'cheque', 'cartao') and data_emissao::date  >= '2023-06-01' AND status = '1'\n\n\n",
        "options": {}
