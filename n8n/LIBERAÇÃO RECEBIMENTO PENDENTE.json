    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Loop para formatar a data de cada item\nitems.forEach(item => {\n  if (item.json.data_recebimento) {\n    item.json.data_recebimento= new Date(item.json.data_recebimento).toISOString().split('T')[0];\n  }\n});\n\nreturn items;\n"
      },
      "id": "81c653ce-ccc7-4f73-b3a6-66bff72f18be",
      "name": "Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        -304
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    mf.unidade,\n    mf.tipo_unidade,\n    mf.data_pagamento::date AS data_pagamento,\n    mf.vlr_pago,\n    ROUND(mf.vlr_pago::numeric * 0.05, 2) AS descontos,\n    mf.classificacao,\n    df.forma_pagamento,\n    mc.codcliente AS codigo_cliente,\n    mc.nome_cliente AS nome_cliente\nFROM movimentacoes_financeiras mf\nLEFT JOIN detalhamento_financeiro df\n       ON mf.chave_detalhamento = df.chave \n      AND df.unidade = mf.unidade \nLEFT JOIN mapeamento_clientes mc \n       ON mf.unidade = mc.unidade\n      AND mf.fornecedor_cliente = mc.nome_cliente\nWHERE \n    mf.tipo_unidade = 'Tempera'\n    AND mf.classificacao IN (\n        'PAGAMENTO DE ADIANTAMENTO',\n        'DEPOSITO NAO IDENTIFICADO'\n    )\n    AND df.forma_pagamento ILIKE '%deposito%'\n    AND mf.data_pagamento::date >= date_trunc('month', current_date - interval '1 month')::date\n    AND mf.data_pagamento::date <  date_trunc('month', current_date)::date\n    AND (\n            (mf.unidade = 'INBRAVIDROS' \n                AND mc.codcliente IN ('4689','5140','4846','5035','4877','4811','4810','4885','4851','4979'))\n        OR  (mf.unidade = 'OAZEM' \n                AND mc.codcliente IN ('11229','11416','6840'))\n        OR  (mf.unidade = 'VITORIA DE SANTO ANTAO' \n                AND mc.codcliente IN ('1009','721','1151','1446','1063','1050','1462','293','1','799','503','1354','1315'))\n        OR  (mf.unidade = '4D VIDROS' \n                AND mc.codcliente IN ('9252','9434','9317','9387','9393'))\n        OR  (mf.unidade = 'FORTALEZA' \n                AND mc.codcliente IN ('1795','109','110'))\n        )\nORDER BY \n    mf.unidade,\n    mc.codcliente,\n    mf.data_pagamento;",
        "options": {}
      },
