    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select unidade, TO_CHAR(totalvendido, 'L 99G999G999D99') as Total, CONCAT(unidade, ': ', TO_CHAR(totalvendido, 'L 99G999G999D99')) as Formatado, totalvendido as Vendas  from (\nselect p.unidade, round(sum(replace(p.valor_unitario_total_com_desconto,',','.')::numeric),2) as TotalVendido from pedidos p \nleft join coes c on p.coes = c.nome \nleft join unidades u on u.unidade = p.unidade \nwhere c.gerafaturamento = 'SIM' and data_pedido::Date = NOW()::dATE and u.ativo = 'S'\ngroup by p.unidade \norder by round(sum(replace(p.valor_unitario_total_com_desconto,',','.')::numeric),2) desc\n) x ",
        "options": {}
      },
