{
  "name": "Vendas de ferragens por vendedor - Acumulado Mês",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\t*, \n\tROUND(abs(custo/venda - 1) * 100,2) as margem\nfrom (\n\tselect \n\t\tunidade,\n\t\tvendedor,\n\t\tcategoria_produto,\n\t\tclasse_produto,\n\t\tsub_classe_produto,\n\t\tNOME_PRODUTO,\n\t\tROUND(SUM(replace(p.valor_unitario_total_com_desconto,',','.')::numeric),2) as venda,\n\t\tROUND(SUM(replace(p.custo_unitario_total_produto,',','.')::numeric),2) as custo,ROUND(SUM(replace(p.qtd_produto,',','.')::numeric),2) as qtd\n\tfrom pedidos p  \n\t\tleft join coes c on p.coes = c.nome \n\twhere \n\t\tc.gerafaturamento = 'SIM' and unidade = 'GM Maceio' \n\t\tand data_pedido::Date >= to_char(NOW()::DATE, 'yyyy-mm-01')::date \n\t\tand categoria_produto = 'FERRAGEM' and classe_produto like ('%POL%')\n\tgroup by unidade, vendedor, categoria_produto, classe_produto, sub_classe_produto, NOME_PRODUTO\n) X",
        "options": {}
      },
