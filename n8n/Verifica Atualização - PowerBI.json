    {
      "parameters": {
        "jsCode": "// Converte cada item do Merge em { datasetId, datasetName, webUrl, lastRefreshEnd, status }\n\nconst out = $input.all().map((item) => {\n  const j = item.json || {};\n\n  // dataset pode estar aninhado (merge by position) ou já planificado\n  const d = j.dataset || j;\n  const r = j.refresh ?? (Array.isArray(j.value) ? j.value[0] : {}) ?? {};\n\n  return {\n    json: {\n      datasetId:   d.datasetId ?? d.id ?? null,\n      datasetName: d.datasetName ?? d.name ?? null,\n      webUrl:      d.webUrl ?? null,\n      lastRefreshEnd: r.endTime ?? null,\n      status:         r.status ?? 'Unknown',\n    },\n  };\n});\n\nreturn out;\n"
      },
