    {
      "parameters": {
        "jsCode": "// Recebe todos os itens do nó anterior\nconst items = $input.all();\n\n// Mapeia cada linha e trata o campo\nreturn items.map(item => {\n  const docOriginal = item.json.NU_CPF_CNPJ || \"\";\n  \n  // Remove tudo que não for número\n  const docLimpo = docOriginal.replace(/\\D/g, \"\");\n  \n  // Verifica o tipo pelo tamanho\n  let tipoDoc = \"\";\n  if (docLimpo.length === 11) {\n    tipoDoc = \"CPF\";\n  } else if (docLimpo.length === 14) {\n    tipoDoc = \"CNPJ\";\n  } else {\n    tipoDoc = \"INVÁLIDO\";\n  }\n\n  // Retorna para o fluxo\n  return {\n    json: {\n      ...item.json,\n      NU_CPF_CNPJ_LIMPO: docLimpo,\n      TIPO_DOCUMENTO: tipoDoc\n    }\n  };\n});\n"
      },
