    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    '{{ $json[\"tipo_unidade\"] }}' as tipo_unidade,\n    '{{ $json[\"unidade\"] }}' as unidade,\n    m.VLR_TIT_ORIG,\n    m.NU_FOR as cod_fornecedor,\n    m.NU_CLI as cod_cliente,\n    m.nu_cta as titulo,\n    m.DS_CPG,\n    m.ds_obs,\n    m.DT_CANC,\n    m.DT_EMISSAO,\n    m.DT_PAGTO,\n    usu.DS_LOGIN as usuario_cancel,\n    usu.NOM_USU,\n    fornec.DS_FOR as fornecedor,\n    cli.DS_CLI as cliente,\n    COALESCE(fornec.DS_FOR, cli.DS_CLI) as cliente_fornec\nfrom mgcta01014 m\nleft join mgusu01010 usu on m.NU_USU_CANC = usu.NU_USU\nleft join mgfor01010 fornec on m.NU_FOR  = fornec.NU_FOR\nleft join mgcli01010 cli on m.NU_CLI = cli.NU_CLI\nwhere m.ID_STAT_LANCTO = '4'\nand m.DT_CANC >= DATE_SUB(NOW(), INTERVAL 1 HOUR)",
        "options": {
          "connectionTimeoutMillis": 10
        }
      },
