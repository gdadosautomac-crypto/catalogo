  "name": "Auditoria Pagamento de Adiantamento",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    mf.tipo_unidade,\n    mf.unidade,\n    mf.data_pagamento,\n    mf.vlr_pago,\n    mf.valor_titulo,\n    mf.fornecedor_cliente,\n    mf.classificacao,\n    mf.descricao,\n    mf.chave as titulo,\n    df.nome_conta,\n    mf.tipo_de_lancamento,\n    mf.plano_conta,\n    df.forma_pagamento ,\n    mf.colaborador\nFROM movimentacoes_financeiras mf\nleft join detalhamento_financeiro df on mf.unidade = df.unidade and mf.chave_detalhamento = df.chave\nWHERE \n    mf.data_pagamento::date = CURRENT_DATE - 1\n    AND mf.tipo_de_lancamento = 'Saida'\n    AND mf.classificacao ILIKE '%ADIANT%'\n    AND mf.fornecedor_cliente IS NOT NULL\nORDER BY \n    mf.unidade, mf.fornecedor_cliente;",
        "options": {}
      },
