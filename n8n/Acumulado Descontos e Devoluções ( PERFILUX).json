    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    '{{ $json[\"tipo_unidade\"] }}' as tipo_unidade,\n    '{{ $json[\"unidade\"] }}' as unidade, \n    SUM(titulo.VLR_DESC) AS desconto_mes\nFROM \n    mgcta01014 titulo\nWHERE \n    titulo.COD_LANCTO = '1'\n    AND titulo.DT_PAGTO >= DATE_FORMAT(CURDATE(), '%Y-%m-01')\n    AND titulo.DT_PAGTO < DATE_FORMAT(CURDATE() + INTERVAL 1 MONTH, '%Y-%m-01')\nGROUP BY \n   tipo_unidade,\n   unidade",
        "options": {}
      },
