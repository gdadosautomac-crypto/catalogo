      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tmf.tipo_unidade, \n\tmf.unidade, \n\tdf.forma_pagamento, \n\tround(replace(mf.vlr_pago, ',','.')::numeric, 2) as Entrada\nfrom movimentacoes_financeiras mf \n\tleft join (\n\t\tselect \n\t\t\tdistinct unidade, \n\t\t\tchave, \n\t\t\tforma_pagamento\n\t\tfrom detalhamento_financeiro\n\t) df on mf.unidade = df.unidade and mf.chave_detalhamento = df.chave\nwhere\n\tmf.data_pagamento::date = current_date\n\tand df.forma_pagamento in ('Boleto', 'Cheque', 'Dinheiro', 'Deposito')\n\tand mf.tipo_de_lancamento = 'Entrada' \ngroup by mf.tipo_unidade, mf.unidade, df.forma_pagamento, mf.vlr_pago\norder by mf.tipo_unidade desc, mf.unidade asc, df.forma_pagamento asc",
        "options": {}
      },
