    {
      "parameters": {
        "operation": "executeQuery",
        "query": "/* Metragem acumulada do Mês - Lojas e Bodinhos */\n\nSELECT\n\tCOALESCE(temp.tipo_unidade, COALESCE(box.tipo_unidade, inc8.tipo_unidade)) AS tipo_unidade,\n\tCOALESCE(temp.unidade, COALESCE(box.unidade, inc8.unidade)) AS unidade, \n\ttemp.metragem_temp, \n\tbox.metragem_box, \n\tinc8.metragem_inc8, \n\tvlr_inc8.vlr_inc8 \nFROM ( \n\tSELECT \n\tp.tipo_unidade, \n\tp.unidade, \n\tROUND(SUM(REPLACE(p.metragem_cobrada, ',', '.')::NUMERIC), 2) AS metragem_temp \n\tFROM pedidos p \n\tLEFT JOIN coes c ON p.coes = c.nome \n\tLEFT JOIN unidades u ON p.unidade = u.unidade \n\tWHERE p.categoria_produto IN ('TEMPERADO', 'TEMPERADO ESPECIAL', 'TEMPERADO PADRÃO') \n\tAND p.tipo_unidade <> 'Tempera' \n\tAND u.matriz IN ('VITORIA DE SANTO ANTAO', 'FORTALEZA', 'Oazem', 'INBRAVIDROS', '4D Vidros') \n\tAND c.gerafaturamento = 'SIM' \n\tAND p.data_hora_pedido::date BETWEEN TO_CHAR(NOW()::DATE, 'yyyy-mm-01')::date AND current_date \n    --AND p.data_hora_pedido::date BETWEEN '2025-12-01' AND '2025-12-31'\n\tGROUP BY p.tipo_unidade, p.unidade \n) AS temp FULL OUTER JOIN ( \n\tSELECT \n\t\tp.tipo_unidade, \n\t\tp.unidade, \n\t\tROUND(SUM(REPLACE(p.metragem_cobrada, ',', '.')::NUMERIC), 2) AS metragem_box \n\tFROM pedidos p \n\t\tLEFT JOIN coes c ON p.coes = c.nome \n\t\tLEFT JOIN unidades u ON p.unidade = u.unidade \n\tWHERE \n\t\tp.categoria_produto IN ('BOX 06MM', 'BOX FORA DE PADRÃO', 'BOX PADRÃO', 'BOX PADRÃO 1800', 'BOX PADRAO 1900', 'BOX PADRÃO 1900') \n\t\tAND p.tipo_unidade <> 'Tempera' AND u.matriz IN ('VITORIA DE SANTO ANTAO', 'FORTALEZA', 'Oazem', 'INBRAVIDROS', '4D Vidros') \n\t\tAND c.gerafaturamento = 'SIM' AND p.data_hora_pedido::date BETWEEN TO_CHAR(NOW()::DATE, 'yyyy-mm-01')::date AND current_date \n        --AND p.data_hora_pedido::date BETWEEN '2025-12-01' AND '2025-12-31'\n\tGROUP BY p.tipo_unidade, p.unidade \n) AS box ON temp.tipo_unidade = box.tipo_unidade AND temp.unidade = box.unidade \nFULL OUTER JOIN ( \n\tSELECT \n\t\tp.tipo_unidade, \n\t\tp.unidade, \n\t\tROUND(SUM(REPLACE(p.metragem_cobrada, ',', '.')::NUMERIC), 2) AS metragem_inc8 \n\tFROM pedidos p \n\t\tLEFT JOIN coes c ON p.coes = c.nome \n\t\tLEFT JOIN unidades u ON p.unidade = u.unidade \n\tWHERE \n\t\tp.categoria_produto IN ('TEMPERADO') AND p.classe_produto LIKE '%INC%' and p.sub_classe_produto like '%8%' \n\t\tAND p.tipo_unidade <> 'Tempera' AND u.matriz IN ('VITORIA DE SANTO ANTAO', 'FORTALEZA', 'Oazem', 'INBRAVIDROS', '4D Vidros') \n\t\tAND c.gerafaturamento = 'SIM' AND p.data_hora_pedido::date BETWEEN TO_CHAR(NOW()::DATE, 'yyyy-mm-01')::date AND current_date \n        --AND p.data_hora_pedido::date BETWEEN '2025-12-01' AND '2025-12-31'\n\tGROUP BY p.tipo_unidade, p.unidade \n) AS inc8 ON temp.tipo_unidade = inc8.tipo_unidade AND temp.unidade = inc8.unidade \nFULL OUTER JOIN ( \n\tSELECT \n\t\tp.tipo_unidade, \n\t\tp.unidade, \n\t\tROUND(SUM(REPLACE(p.valor_unitario_total_com_desconto, ',', '.')::NUMERIC), 2) AS vlr_inc8 \n\tFROM pedidos p \n\t\tLEFT JOIN coes c ON p.coes = c.nome \n\t\tLEFT JOIN unidades u ON p.unidade = u.unidade \n\tWHERE \n\t\tp.categoria_produto IN ('TEMPERADO') AND p.classe_produto LIKE '%INC%' and p.sub_classe_produto like '%8%' \n\t\tAND p.tipo_unidade <> 'Tempera' AND u.matriz IN ('VITORIA DE SANTO ANTAO', 'FORTALEZA', 'Oazem', 'INBRAVIDROS', '4D Vidros') \n\t\tAND c.gerafaturamento = 'SIM' AND p.data_hora_pedido::date BETWEEN TO_CHAR(NOW()::DATE, 'yyyy-mm-01')::date AND current_date \n        --AND p.data_hora_pedido::date BETWEEN '2025-12-01' AND '2025-12-31'\n\tGROUP BY p.tipo_unidade, p.unidade \n) AS vlr_inc8 ON temp.tipo_unidade = vlr_inc8.tipo_unidade AND temp.unidade = vlr_inc8.unidade",
        "options": {}
      },
