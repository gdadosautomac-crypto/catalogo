    {
      "parameters": {
        "operation": "executeQuery",
        "query": "/* METRAGEM DE BOX DO DIA */ \n\nselect \n\tcoalesce(inc.tipo_unidade, clr.tipo_unidade) as tipo_unidade, \n\tcoalesce(inc.unidade, clr.unidade) as unidades, \n\tinc.mrt_box as mtr_inc, \n\tclr.mrt_box as mtr_clr \nfrom ( \n\tSELECT \n\t\tp.tipo_unidade, \n\t\tu.nome_sugerido as unidade, \n\t\tROUND(SUM(REPLACE(p.metragem_cobrada, ',', '.')::NUMERIC), 2) AS mrt_box \n\tFROM pedidos p \n\t\tLEFT JOIN coes c ON p.coes = c.nome \n\t\tLEFT JOIN unidades u ON p.unidade = u.unidade \n\tWHERE \n\t\tp.categoria_produto IN ('BOX 06MM', 'BOX FORA DE PADRÃO', 'BOX PADRÃO', 'BOX PADRÃO 1800', 'BOX PADRAO 1900', 'BOX PADRÃO 1900') \n\t\tAND p.tipo_unidade <> 'Tempera' AND c.gerafaturamento = 'SIM' and p.classe_produto = 'INCOLOR' \n\t\tAND p.data_hora_pedido::date = current_date --para acumulado no dia\n\tGROUP BY p.tipo_unidade, u.nome_sugerido \n) as inc full OUTER JOIN ( \n\tSELECT \n\t\tp.tipo_unidade, \n\t\tu.nome_sugerido as unidade, \n\t\tROUND(SUM(REPLACE(p.metragem_cobrada, ',', '.')::NUMERIC), 2) AS mrt_box \n\tFROM pedidos p \n\t\tLEFT JOIN coes c ON p.coes = c.nome \n\t\tLEFT JOIN unidades u ON p.unidade = u.unidade \n\tWHERE \n\t\tp.categoria_produto IN ('BOX 06MM', 'BOX FORA DE PADRÃO', 'BOX PADRÃO', 'BOX PADRÃO 1800', 'BOX PADRAO 1900', 'BOX PADRÃO 1900') \n\t\tAND p.tipo_unidade <> 'Tempera' AND c.gerafaturamento = 'SIM' and p.classe_produto IN ('FUME', 'VERDE') \n\t\tAND p.data_hora_pedido::date = current_date --para acumulado no dia\n\tGROUP BY p.tipo_unidade, u.nome_sugerido \n) as clr on inc.unidade = clr.unidade",
        "options": {}
      },
