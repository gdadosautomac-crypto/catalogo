    {
      "parameters": {
        "operation": "executeQuery",
        "query": "(select \n\teg.unidade, \n\tround(sum(valor_entregue + coalesce(acrescimo, 0) ), 2) as valor, \n\tROUND(sum(replace(metragem_entregue, ',','.')::numeric), 2) as m2\nfrom entregas_geral eg \n\tleft join unidades u on eg.tipo_unidade = u.tipo_unidade and eg.unidade = u.unidade \nwhere \n\teg.tipo_unidade = 'Bodinho' and u.matriz in ('VITORIA DE SANTO ANTAO') \n\tand data_hora_entregue::date between TO_CHAR(NOW()::DATE, 'yyyy-mm-01')::date and current_date\ngroup by eg.unidade\n) union all (\nselect \n\t'TOTAL' as unidade, \n\tround(sum(valor_entregue + coalesce(acrescimo, 0) ), 2) as total, \n\tROUND(sum(replace(metragem_entregue, ',','.')::numeric), 2) as m2_total\nfrom entregas_geral eg \n\tleft join unidades u on eg.tipo_unidade = u.tipo_unidade and eg.unidade = u.unidade \nwhere eg.tipo_unidade = 'Bodinho' and u.matriz in ('VITORIA DE SANTO ANTAO') and data_hora_entregue::date between TO_CHAR(NOW()::DATE, 'yyyy-mm-01')::date and current_date\n)",
        "options": {}
      },
