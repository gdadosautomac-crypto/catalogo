{
  "name": "Auditoria Compras",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select distinct \n    pc.tipo_unidade,\n    pc.unidade,\n    pc.pedido,\n    pc.cod_fornecedor,\n    pc.fornecedor,\n    pc.data_pedido,\n    pc.data_finalizacao,\n    pc.previsao_entrega,\n    CURRENT_DATE AS data_atual,\n    (CURRENT_DATE - TO_DATE(pc.previsao_entrega, 'YYYY-MM-DD')) AS dias_atraso,\n    REPLACE(ROUND(CAST(REPLACE(pc.valor_total_pedido, ',', '.') AS NUMERIC), 2)::TEXT, '.', ',') AS valor_total_pedido,\n    REPLACE(ROUND(CAST(REPLACE(pc.valor_pago, ',', '.') AS NUMERIC), 2)::TEXT, '.', ',') AS valor_pago,\n    REPLACE(ROUND(CAST(REPLACE(pc.valor_pendente, ',', '.') AS NUMERIC), 2)::TEXT, '.', ',') AS valor_pendente,\n    CASE\n        WHEN CAST(pc.status AS INTEGER) = 4 THEN 'FINALIZADO'\n        WHEN CAST(pc.status AS INTEGER) = 2 THEN 'PARCIAL'   \n        WHEN CAST(pc.status AS INTEGER) = 3 THEN 'CANCELADO'  \n        WHEN CAST(pc.status AS INTEGER) = 1 THEN 'GERADO'\n    END AS status,\n    pc.usuario_pedido\nfrom\n\tpedidos_compras pc\nwhere \n\t    TO_DATE(pc.previsao_entrega, 'YYYY-MM-DD') <= CURRENT_DATE - INTERVAL '7 days'\n    AND TO_DATE(pc.data_pedido, 'YYYY-MM-DD') >= CURRENT_DATE - INTERVAL '30 days'\n    and CAST(pc.status as integer) != 4;",
        "options": {}
      },
