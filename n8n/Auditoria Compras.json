      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Loop para formatar a data de cada item\nitems.forEach(item => {\n  if (item.json.data_pedido) {\n    item.json.data_pedido = new Date(item.json.data_pedido).toISOString().split('T')[0];\n  }\n  \n  if (item.json.previsao_entrega) {\n    item.json.previsao_entrega = new Date(item.json.previsao_entrega).toISOString().split('T')[0];\n  }\n\n    if (item.json.data_atual) {\n    item.json.data_atual = new Date(item.json.data_atual).toISOString().split('T')[0];\n  }\n  \n});\n\nreturn items;\n"
      },
