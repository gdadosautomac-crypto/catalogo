  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT *\nFROM movimentacoes_financeiras mf\nWHERE \n    tipo_de_lancamento = 'Saida'\n    AND mf.classificacao ilike '%saida%'\n    AND data_emissao::date BETWEEN \n        CASE \n            WHEN EXTRACT(DOW FROM CURRENT_DATE) = 2  -- terça\n                THEN CURRENT_DATE - INTERVAL '5 days'\n            WHEN EXTRACT(DOW FROM CURRENT_DATE) = 4  -- quinta\n                THEN CURRENT_DATE - INTERVAL '3 days'\n        END\n        AND CURRENT_DATE - INTERVAL '1 day';",
        "options": {}
      },
