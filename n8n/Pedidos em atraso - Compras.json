    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n\ttipo_unidade, \n\tunidade,\n\tdata_pedido::date, \n\tfornecedor, \n\tpedido, \n\tROUND(MAX(replace(valor_total_pedido,',','.')::numeric),2) as ValorPedido,  \n\tcoalesce(previsao_entrega::date, data_pedido::date + '15 DAYS'::interval)::date as Previsao,\n\t(coalesce(previsao_entrega::date, data_pedido::date + '15 DAYS'::interval)::date - now()::date) as DiasAtrasos\nfrom pedidos_compras pc \nwhere \n\tstatus = '1' and (coalesce(previsao_entrega::date, data_pedido::date + '15 DAYS'::interval)::date - now()::date) <= 5\ngroup by tipo_unidade, unidade, data_pedido::date, fornecedor, pedido, coalesce(previsao_entrega::date, data_pedido::date + '15 DAYS'::interval)::date\norder by tipo_unidade desc, unidade asc, fornecedor, pedido",
        "options": {}
      },
