      "id": "acce0d08-4515-4144-8ab8-0bd8e2ab0cd9",
      "name": "XML"
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\n// no seu print, o array está em items[0].json.data (data[0], data[1]...)\nconst list = items[0].json?.data || [];\n\nfor (const cte of list) {\n  output.push({ json: cte });\n}\n\nreturn output;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        256
      ],
      "id": "060da6e7-c3a0-493d-bdfc-20c0cebda8ce",
      "name": "Extrair XML"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// pega o xml do lugar correto\nconst rawXml = item.json.xml;\n\n// se não existir xml, descarta só este item\nif (!rawXml || typeof rawXml !== 'string') {\n  return;\n}\n\n// decodifica base64 → XML texto\nitem.json.xml = Buffer.from(rawXml, 'base64').toString('utf-8');\n\n// retorno correto\nreturn item;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        256
      ],
      "id": "bbdd3bea-a18c-498c-ade9-c3b43d416c6b",
      "name": "Separar Items"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const infCte = item.json?.cteProc?.CTe?.infCte;\n\n// se não existir estrutura de CT-e válida\nif (!infCte) {\n  return {\n    json: {\n      valido: false\n    }\n  };\n}\n\n// dados básicos\nconst chave_cte = infCte.Id?.replace('CTe', '') || null;\nconst ide = infCte.ide || {};\n\n// valores\nconst valor_frete = infCte.vPrest?.vTPrest || null;\n\n// participantes\nconst emit = infCte.emit || {};\nconst rem  = infCte.rem  || {};\nconst dest = infCte.dest || {};\nconst toma4 = ide?.toma4 || null;\nconst toma3 = ide?.toma3 || null;\n\nreturn {\n  json: {\n    valido: true,\n    chave_cte,\n    numero_cte: ide.nCT || null,\n    serie: ide.serie || null,\n    data_emissao: ide.dhEmi || null,\n    valor_frete,\n    cnpj_emitente: emit.CNPJ || null,\n    cnpj_remetente: rem.CNPJ || null,\n    cnpj_destinatario: dest.CNPJ || null,\n    cnpj_tomador:\n      toma4?.CNPJ ||\n      (toma3 ? 'TOMA3' : null),\n    data_ingestao: new Date().toISOString()\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        256
      ],
