    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tu.tipo_unidade, \n\tu.und, \n\tund.unidade \nfrom (\n\tselect \n\t\ttipo_unidade, \n\t\tunidade as und \n\tfrom pedidos \n\tgroup by tipo_unidade, unidade \n) u \n\tleft join unidades und on u.und = und.unidade \nwhere und.unidade is null",
        "options": {}
      },
