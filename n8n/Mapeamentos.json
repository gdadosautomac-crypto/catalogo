      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tcoes, \n\tunidade \nfrom pedidos p \n    left join coes c on p.coes = c.nome \nwhere \n    c.nome is null and p.coes is not null \ngroup by coes, unidade",
        "options": {}
      },
