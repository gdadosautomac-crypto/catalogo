    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tma.unidade, \n\tma.data_movimentacao::date, \n\tma.usuario, \n\tma.descricao, \n\tma.motivo as motivo_ma, \n\tmma.motivo as motivo_mma, \n\tmma.demonstracao \nfrom movimentacoes_avulsas ma \n\tleft join mapeamento_mov_avulsas mma on ma.motivo = mma.motivo \nwhere data_movimentacao::date between to_char(now()::date, 'yyyy-mm-01')::date and current_date \n\tand mma.motivo is null \ngroup by ma.unidade, ma.data_movimentacao::date, ma.usuario, ma.descricao, ma.motivo, mma.motivo, mma.demonstracao",
        "options": {}
      },
