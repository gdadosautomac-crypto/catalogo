    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\t'Conta Interna' as tipo_documento, \n\tx.unidade, \n\tx.nome_cliente as conta, \n\ty.nome_cliente as mapeamento \nfrom painel_financeiro x \n\tleft join mapeamento_contas_internas y on x.nome_cliente = y.nome_cliente and x.unidade = y.unidade \nwhere \n\tx.tipo_documento = 'Conta Interna' and y.nome_cliente is null \ngroup by x.unidade, x.nome_cliente, y.nome_cliente",
        "options": {}
      },
