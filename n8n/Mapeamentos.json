    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tp.unidade,\n\tp.nome_produto, \n\tp.categoria_produto, \n\tp.classe_produto,  \n\tmcp.nivel, \n\tmcp.nivel_custo \nfrom pedidos p \n\tleft join mapeamento_categorias_python mcp on CONCAT(p.categoria_produto, p.classe_produto) = CONCAT(mcp.categoria, mcp.classe) \nwhere \n\tdata_pedido::date >= '2025-01-01' and nivel is null \ngroup by p.unidade, p.nome_produto, p.categoria_produto, p.classe_produto, mcp.nivel, mcp.nivel_custo",
        "options": {}
      },
