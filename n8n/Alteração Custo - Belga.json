        "query": "SELECT \n    'Belga' as Unidade,\n    m.NU_LOG,\n    m.NU_USU,\n    usuario.DS_LOGIN AS login,\n    usuario.NOM_USU AS nome_usuario,\n    m.DTH AS data_operacao,\n    m.tipo,\n    m.TABELA,\n    m.DS_LOG\nFROM mglog01011 m\nLEFT JOIN mgusu01010 usuario ON m.NU_USU = usuario.NU_USU\nWHERE m.TABELA = 'mgpro01010'\nAND m.TIPO = '3'\nAND m.DTH >= DATE_SUB(NOW(), INTERVAL 1 HOUR);\n",
