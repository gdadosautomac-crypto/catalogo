      "parameters": {
        "operation": "executeQuery",
        "query": "select unidade, TO_CHAR(Entregue, 'L 99G999G999D99') as Total, CONCAT(unidade, ': ', TO_CHAR(Entregue, 'L 99G999G999D99')) as Formatado, Entregue  from (\nselect \neg.unidade,\nround(sum(valor_entregue + coalesce(acrescimo,0))::numeric,2) as Entregue\nfrom entregas_geral eg \nleft join unidades u on u.unidade = eg.unidade and u.ativo = 'S'\nwhere data_hora_entregue::date = NOW()::DATE\ngroup by eg.unidade\norder by round(sum(valor_entregue + coalesce(acrescimo,0))::numeric,2) desc ) x ",
