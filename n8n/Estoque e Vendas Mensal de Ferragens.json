{
  "name": "Estoque e Vendas Mensal de Ferragens",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n\tecp.classe, \n\tecp.cod_produto, \n\tecp.nome_produto, \n\tecp.estoque_qtd,\n\tcoalesce(itens.vendamensal,0) as VendaMensal,\n\tecp.custo_unt,\n\tecp.preco_venda\nfrom estoque_completo_produtos ecp \n\tleft join (\n\t\tselect \n\t\t\tcod_produto, SUM(replace(QTD_PRODUTO,',','.')::numeric) as VendaMensal\n\t\tfrom pedidos p \n\t\t\tleft join coes c on p.coes = c.nome \n\t\twhere\n\t\t\tunidade = 'GM Maceio' and categoria_produto = 'FERRAGEM' \n\t\t\tand classe_produto like ('%POL%') and c.gerafaturamento = 'SIM'\n\t\t\tand data_pedido::Date >= to_char(NOW()::DATE, 'yyyy-mm-01')::date \n\t\tgroup by cod_produto\n\t) itens on itens.cod_produto::numeric = ecp.id_produto::numeric\nwhere \n\tunidade = 'GM Maceio' and categoria = 'FERRAGEM' and classe like ('%POL%')",
        "options": {}
      },
