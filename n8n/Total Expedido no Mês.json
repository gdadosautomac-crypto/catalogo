      "parameters": {
        "operation": "executeQuery",
        "query": "select unidade, TO_CHAR(Entregue, 'L 99G999G999D99') as Total, CONCAT(unidade, ': ', TO_CHAR(Entregue, 'L 99G999G999D99')) as Formatado, Entregue  from (\nselect \neg.unidade,\nround(sum(valor_entregue + coalesce(acrescimo,0))::numeric,2) as Entregue\nfrom entregas_geral eg \nleft join unidades u on u.unidade = eg.unidade \nwhere data_hora_entregue::date >= TO_CHAR(NOW()::DATE, 'YYYY-MM-01')::DATE and u.ativo = 'S'\ngroup by eg.unidade\norder by round(sum(valor_entregue + coalesce(acrescimo,0))::numeric,2) desc ) x ",
        "options": {}
      },
