  "name": "Quebra galho DRE - Manu",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\teg.unidade, \n\teg.categoria_produto, \n\teg.classe_produto,\n\teg.sub_classe_produto, \n\tround(sum(eg.valor_entregue + coalesce(acrescimo,0)),2) as valor, \n\tround(sum(replace(eg.metragem_entregue,',','.')::numeric),2) as metragem,\n\tround(sum(eg.custo_entregue),2) as custo,\n\teg.data_hora_entregue::date\nfrom entregas_geral eg \n\tleft join unidades u on eg.tipo_unidade = u.tipo_unidade and eg.unidade = u.unidade \nwhere \n\teg.unidade = 'VITORIA DE SANTO ANTAO' \n\tand eg.data_hora_entregue::date between TO_CHAR(NOW()::DATE - interval '1 month', 'yyyy-mm-01')::date and current_date - 2\ngroup by eg.unidade, eg.categoria_produto, eg.classe_produto, eg.sub_classe_produto, eg.data_hora_entregue::date",
        "options": {}
      },
