    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    concat(eg.unidade, '_', eg.carga) AS key,\n    eg.carga,\n    '{{ $('Solicitante1').item.json.contato }}' as contato, \n    eg.rota,\n    TO_CHAR(data_hora_entregue::DATE,'YYYY-MM-DD') as data, \n    eg.nome_produto, \n    CASE\n        WHEN eg.coes = 'ENGENHARIA PADRÃO'::text THEN 'ENGENHARIA PADRÃO'::text\n        ELSE eg.categoria_produto\n    END AS categoria,\n    round(sum(eg.metragem_entregue::numeric), 2) AS m2,\n    round(sum(eg.peso_entregue::numeric), 2) AS peso,\n    round(sum(eg.valor_entregue+COALESCE(acrescimo,0)), 2) AS valor,\n    round(sum(eg.custo_entregue), 2) AS custo\nFROM entregas_geral eg\nWHERE \n    eg.unidade::text = '{{ $('Solicitante1').item.json.unidade }}' AND eg.carga = '{{ $('Solicitante1').item.json.cargaIniMSG }}'\n    --and data_hora_entregue::date = '2024-09-23' \nGROUP BY (concat(eg.unidade, '_', eg.carga)), eg.carga, eg.coes, TO_CHAR(data_hora_entregue::DATE,'YYYY-MM-DD'), eg.categoria_produto, eg.rota, eg.nome_produto\norder by eg.carga desc",
        "options": {}
      },
