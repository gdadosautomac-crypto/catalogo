    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  return {\n    ...item,\n    json: {\n      ...item.json,\n      total_pendente: item.json.total_pendente !== null && item.json.total_pendente !== undefined \n        ? Number(item.json.total_pendente).toFixed(2).replace('.', ',') \n        : null,\n      total_devido: item.json.total_devido !== null && item.json.total_devido !== undefined \n        ? Number(item.json.total_devido).toFixed(2).replace('.', ',') \n        : null,\n      saldo: item.json.saldo !== null && item.json.saldo !== undefined \n        ? Number(item.json.saldo).toFixed(2).replace('.', ',') \n        : null\n    }\n  };\n});\n"
      },
