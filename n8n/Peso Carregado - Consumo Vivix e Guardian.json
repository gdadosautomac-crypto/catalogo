    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n    TO_CHAR(ROUND(SUM(replace(peso,',','.')::numeric),2), '9G999G999D99') AS peso_guardian_formatado,\n\tROUND(SUM(replace(peso,',','.')::numeric),2) as pesog \nfrom ( \n\tselect \n\t\temissor, \n\t\tdata_emissao::date, \n\t\tnfe, \n\t\tdestinario, \n\t\tpeso, \n\t\tnatureza_operacao \n\tfrom notas_fiscais nf \n\twhere \n\t\temissor like ('%GUARDIAN%') and natureza_operacao not like ('Rem%') \n\t\tand data_emissao::date >= TO_CHAR(NOW()::DATE, 'yyyy-mm-01')::date \n\tgroup by emissor, nfe, destinario, peso, natureza_operacao, data_emissao::date \n\torder by data_emissao::date desc \n) x",
        "options": {}
      },
      "id": "5a4b65be-3292-49b8-80ea-4ad5b10ae947",
      "name": "Guardian1",
      "type": "n8n-nodes-base.postgres",
