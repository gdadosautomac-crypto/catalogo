    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const precoBanco = parseFloat(item.json.valor_unitario_total_com_desconto);\n  const precoPlanilha = parseFloat(item.json.precovenda);\n\n  if (precoBanco !== precoPlanilha) {\n    return {\n      json: {\n        ...item.json,\n        status: 'Divergente'\n      }\n    };\n  } else {\n    return {\n      json: {\n        ...item.json,\n        status: 'Ok'\n      }\n    };\n  }\n});"
      },
