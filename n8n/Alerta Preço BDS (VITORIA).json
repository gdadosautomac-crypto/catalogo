    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  p.unidade, \n  p.categoria_produto, \n  p.classe_produto, \n  p.cod_pedido,\n  p.metragem_cobrada ,\n  p.nome_cliente,\n  p.custo_unitario_produto ,\nROUND(REPLACE(p.valor_unitario_com_desconto, ',', '.')::numeric, 2) AS valor_unitario_com_desconto,\n  p.nome_produto, \n  ROUND(p.valor_unitario_total_com_desconto::numeric) AS valor_unitario_total_com_desconto,\n  CASE \n    WHEN p.categoria_produto = 'TEMPERADO' THEN \n      CASE \n        WHEN p.classe_produto = 'INCOLOR' THEN \n          CONCAT('INCOLOR ', REGEXP_REPLACE(p.nome_produto, '.*([0-9]{2}MM).*', '\\1'))\n        ELSE \n          CONCAT('COLORIDO ', REGEXP_REPLACE(p.nome_produto, '.*([0-9]{2}MM).*', '\\1'))\n      END\n    WHEN p.categoria_produto = 'BOX PADRÃO' THEN \n      CASE \n        WHEN p.classe_produto = 'INCOLOR' THEN 'BOX INCOLOR'\n        ELSE 'BOX COLORIDO'\n      END\n    ELSE \n      'OUTROS'\n  END AS produto\nFROM pedidos p\nWHERE p.unidade IN ('ARCOVERDE', 'BELO JARDIM', 'CABO', 'GOIANA', 'GRAVATA', 'IGARASSU', 'PONTO VIDRO', 'SANTA CRUZ')\n  AND p.categoria_produto IN ('TEMPERADO', 'BOX PADRÃO')\n  AND TO_TIMESTAMP(p.last_updated, 'YYYY-MM-DD HH24:MI:SS') >= NOW() - INTERVAL '30 minutes'\n",
        "options": {}
      },
