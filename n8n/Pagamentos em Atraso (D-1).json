    {
      "parameters": {
        "jsCode": "const state = $getWorkflowStaticData('global');\nconst unitName = $('Edit Fields').item.json.unidade;\nconst rows = $input.all();\n\nif (!rows || rows.length === 0) {\n  state.summary = [...(state.summary || []), { unit: unitName, count: 0 }];\n  return [{ json: { skipped: true } }];\n}\n\nstate.rows = [...(state.rows || []), ...rows.map(r => ({ json: r.json }))];\nstate.summary = [...(state.summary || []), { unit: unitName, count: rows.length }];\n\nreturn rows;"
      },
