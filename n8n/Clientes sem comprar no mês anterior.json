  "name": "Clientes sem comprar no mês anterior",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- GM Maceio - Espelho e Temp - Clientes que não compraram no mês anterior (60 dias)\n\nselect \n\ttre.cod_cliente, \n\ttre.nome_cliente, \n\ttre.categoria_produto\nfrom (\n\tselect \n\t\tcod_cliente, \n\t\tnome_cliente, \n\t\tcategoria_produto--, data_pedido::date \n\tfrom pedidos p \n\twhere \n\t\tunidade = 'GM Maceio' \n\t\tand data_pedido::date between TO_CHAR(NOW()::DATE - interval '3 month', 'yyyy-mm-01')::date and (TO_CHAR(NOW()::DATE, 'yyyy-mm-01')::date - interval '1 month' - interval '1 day')\n\tgroup by cod_cliente, nome_cliente, categoria_produto--, data_pedido::date \n) tre\nleft join (\n\tselect \n\t\tcod_cliente, \n\t\tnome_cliente, \n\t\tcategoria_produto--, data_pedido::date \n\tfrom pedidos p \n\twhere \n\t\tunidade = 'GM Maceio' \n\t\tand data_pedido::date between TO_CHAR(NOW()::DATE - interval '1 month', 'yyyy-mm-01')::date and (TO_CHAR(NOW()::DATE, 'yyyy-mm-01')::date - interval '1 day')\n\tgroup by cod_cliente, nome_cliente, categoria_produto--, data_pedido::date \n) n on tre.cod_cliente = n.cod_cliente\nwhere n.cod_cliente is null",
        "options": {}
      },
