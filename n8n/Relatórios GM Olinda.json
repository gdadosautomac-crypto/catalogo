        "query": "SELECT \n\tmf.tipo_unidade, \n\tmf.unidade, \n\tmf.data_pagamento::date::text AS data_pagamento, \n\tmf.centro_custo, \n\tmf.classificacao, \n\tmf.plano_conta, \n\tmf.chave, \n\tmf.descricao, \n\tmf.fornecedor_cliente, \n\tmf.colaborador, \n\tround(replace(mf.vlr_pago, ','::text, '.'::text)::numeric, 2) AS valor \nFROM movimentacoes_financeiras mf \nWHERE \n\tmf.data_pagamento::date >= to_char(now()::date::timestamp with time zone, 'yyyy-mm-01'::text)::date \n\tAND mf.data_pagamento::date <= CURRENT_DATE AND mf.tipo_de_lancamento = 'Saida'::text and unidade in ('OLINDA') \norder by unidade, centro_custo desc, classificacao asc, plano_conta ",
