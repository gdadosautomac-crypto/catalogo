          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tvendedor, \n\tcategoria_produto, \n\tround(sum(valor_entregue + coalesce(acrescimo, 0) ), 2) as expedido, \n\tROUND(sum(custo_entregue), 2) as custo_expedido, \n\tround(abs(sum(custo_entregue) / nullif((sum(valor_entregue) - 1), 0)), 4) as Margem, \n\tROUND(sum(replace(metragem_entregue, ',','.')::numeric), 2) as m2, \n\tROUND(sum(qtd_entregue), 2) as qtd_entregue \nfrom entregas_geral eg \nwhere \n\tunidade = 'OLINDA' and data_hora_entregue::date between to_char(now()::date, 'yyyy-mm-01')::date and current_date \ngroup by vendedor, categoria_produto ",
