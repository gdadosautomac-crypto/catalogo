    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tvendedor, \n\tcategoria_produto, \n\tvendido, \n\tround(abs(custo/vendido - 1),2) as margem, \n\tqtd_cliente, \n\tround(vendido/qtd_cliente,2) as ticket_medio \nfrom (\n\tselect \n\t\tvendedor, \n\t\tcategoria_produto, \n\t\tROUND(SUM(replace(p.valor_unitario_total_com_Desconto,',','.')::numeric),2) as vendido,\n\t\tROUND(SUM(replace(p.custo_unitario_total_produto,',','.')::numeric),2) as custo,\n\t\tCOUNT(distinct cod_cliente) as qtd_cliente\n\tfrom pedidos p\n\t\tleft join coes c on p.coes = c.nome \n\twhere \n\t\tdata_pedido::Date >= to_char(NOW()::dATE, 'yyyy-mm-01')::date and unidade = 'OLINDA' and c.gerafaturamento = 'SIM'\n\tgroup by categoria_produto, vendedor\n) x ",
        "options": {}
      },
