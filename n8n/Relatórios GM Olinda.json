    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tvendedor, \n\tcategoria_produto, \n\texpedido, \n\tround(abs(custo/expedido - 1),2) as margem, \n\tqtd_cliente, \n\tround(expedido/qtd_cliente,2) as ticket_medio \nfrom (\n\tselect \n\t\tvendedor, \n\t\tcategoria_produto, \n\t\tround(sum(valor_entregue + coalesce(acrescimo, 0) ), 2) as expedido, \n\t\tROUND(sum(custo_entregue), 2) as custo, \n\t\tCOUNT(distinct cod_cliente) as qtd_cliente \n\tfrom entregas_geral eg \n\twhere \n\t\tdata_hora_entregue::Date = NOW()::DATE and unidade = 'OLINDA' \n\tgroup by categoria_produto, vendedor \n) x ",
        "options": {}
      },
      "id": "76fac2e6-cdcb-4887-b9ff-d3618088b38e",
      "name": "Expedido Dia",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        1024,
        608
      ],
      "credentials": {
        "postgres": {
          "id": "G50fA6A0L90xaBIe",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tvendedor, \n\tcategoria_produto, \n\tvendido, \n\tround(abs(custo/vendido - 1),2) as margem, \n\tqtd_cliente, \n\tround(vendido/qtd_cliente,2) as ticket_medio \nfrom (\n\tselect \n\t\tvendedor, \n\t\tcategoria_produto, \n\t\tROUND(SUM(replace(p.valor_unitario_total_com_Desconto,',','.')::numeric),2) as vendido, \n\t\tROUND(SUM(replace(p.custo_unitario_total_produto,',','.')::numeric),2) as custo, \n\t\tCOUNT(distinct cod_cliente) as qtd_cliente \n\tfrom pedidos p \n\t\tleft join coes c on p.coes = c.nome \n\twhere \n\t\tdata_pedido::Date = NOW()::dATE and unidade = 'OLINDA' and c.gerafaturamento = 'SIM' \n\tgroup by categoria_produto, vendedor \n) x ",
        "options": {}
      },
      "id": "67231902-adab-40af-b0db-b6c58fcc40a5",
      "name": "Vendido Dia",
      "type": "n8n-nodes-base.postgres",
