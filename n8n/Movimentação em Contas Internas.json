  "name": "Movimentação em Contas Internas",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    mf.tipo_unidade, \n    mf.unidade, \n    df.forma_pagamento, \n    mf.tipo_de_lancamento, \n    mf.data_pagamento::date AS data_pagamento,\n    mf.valor_titulo ,\n    mf.vlr_pago ,\n    df.valor_pago, \n    df.chave , \n    mf.chave as titulo,\n    mf.classificacao, \n    mf.descricao, \n    mf.fornecedor_cliente, \n    mf.colaborador, \n    df.nome_conta\nFROM movimentacoes_financeiras mf\nLEFT JOIN detalhamento_financeiro df \n    ON mf.chave_detalhamento  = df.chave\nLEFT JOIN mapeamento_contas_internas mci \n    ON mci.nome_cliente = df.nome_conta \n    AND mci.unidade = df.unidade\nWHERE \n    df.forma_pagamento = 'Conta Interna'\n    AND mci.tipo_conta = 'CONTROLE'\n    and df.nome_conta not in ('Saldo Têmpera', 'PAG PIX')\n    AND mf.data_pagamento::date = CURRENT_DATE - INTERVAL '1 day';",
        "options": {}
      },
