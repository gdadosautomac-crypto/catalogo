    {
      "parameters": {
        "jsCode": "// Este nó formata o campo \"data_pagamento\" vindo do banco\n// Exemplo: converte \"Wed Oct 29 2025 00:00:00 GMT-0300 (Brasilia Standard Time)\"\n// em \"29/10/2025\"\n\nreturn items.map(item => {\n  const original = item.json.data_pagamento;\n\n  // Garante que a data seja um objeto Date válido\n  const date = new Date(original);\n\n  // Monta o formato dd/mm/yyyy\n  const dia = String(date.getDate()).padStart(2, '0');\n  const mes = String(date.getMonth() + 1).padStart(2, '0');\n  const ano = date.getFullYear();\n\n  item.json.data_pagamento_formatada = `${dia}/${mes}/${ano}`;\n\n  return item;\n});\n"
      },
