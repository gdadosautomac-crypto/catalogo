{
  "name": "Vendas por cliente dos últimos 6 meses - GM Maceió",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tnome_cliente,\n\tnome_produto,\n\tROUND(SUM(CASE WHEN data_pedido >= CURRENT_DATE - INTERVAL '1 month' AND data_pedido <= CURRENT_DATE THEN venda end),2) AS mes_1,\n\tROUND(SUM(CASE WHEN data_pedido >= CURRENT_DATE - INTERVAL '2 months' AND data_pedido <= CURRENT_DATE - INTERVAL '1 month' THEN venda END),2) AS mes_2,\n\tROUND(SUM(CASE WHEN data_pedido >= CURRENT_DATE - INTERVAL '3 months' AND data_pedido <= CURRENT_DATE - INTERVAL '2 months' THEN venda END),2) AS mes_3,\n\tROUND(SUM(CASE WHEN data_pedido >= CURRENT_DATE - INTERVAL '4 months' AND data_pedido <= CURRENT_DATE - INTERVAL '3 months' THEN venda END),2) AS mes_4,\n\tROUND(SUM(CASE WHEN data_pedido >= CURRENT_DATE - INTERVAL '5 months' AND data_pedido <= CURRENT_DATE - INTERVAL '4 months' THEN venda END),2) AS mes_5,\n\tROUND(SUM(CASE WHEN data_pedido >= CURRENT_DATE - INTERVAL '6 months' AND data_pedido <= CURRENT_DATE - INTERVAL '5 months' THEN venda END),2) AS mes_6\nfrom (\n\tselect \n\t\tdata_pedido::Date,\n\t\tunidade,\n\t\tvendedor,\n\t\tcategoria_produto,\n\t\tclasse_produto,\n\t\tsub_classe_produto,\n\t\tNOME_PRODUTO,\n\t\tnome_cliente,\n\t\tROUND(SUM(replace(p.valor_unitario_total_com_desconto,',','.')::numeric),2) as venda,\n\t\tROUND(SUM(replace(p.custo_unitario_total_produto,',','.')::numeric),2) as custo,\n\t\tROUND(SUM(replace(p.qtd_produto,',','.')::numeric),2) as qtd\n\tfrom pedidos p  \n\t\tleft join coes c on p.coes = c.nome \n\twhere \n\t\tc.gerafaturamento = 'SIM' and unidade = 'GM Maceio' and data_pedido::Date >= (to_char(NOW()::DATE, 'yyyy-mm-01')::date - '6 MONTH'::interval) \n\t\tand categoria_produto = 'FERRAGEM' and classe_produto like ('%POL%')\n\tgroup by unidade, vendedor, categoria_produto, classe_produto, sub_classe_produto, NOME_PRODUTO, nome_cliente, data_pedido\n) X \ngroup by nome_cliente, nome_produto",
        "options": {}
      },
