      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    '{{ $json[\"tipo_unidade\"] }}' as tipo_unidade,\n    '{{ $json[\"unidade\"] }}' as unidade,\n\ttitulo.DT_VENCTO as data_vencimento,\n\ttitulo.DS_CPG as descricao,\n\ttitulo.VLR_TIT_ORIG,\n\tfornec.DS_FOR\nfrom mgcta01014 titulo \nleft join mgfor01010 fornec on titulo.NU_FOR = fornec.NU_FOR \nwhere TITULO.COD_LANCTO = '2' and titulo.ID_STAT_LANCTO = '1'\nand titulo.NU_FOR = '{{ $json.NU_FOR }}'",
