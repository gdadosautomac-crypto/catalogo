  "name": "Clientes sem comprar Espelho e Temperado",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- GM Maceio - Espelho e Temp - Clientes que não compraram no mês anterior\n\nselect \n\ttre.cod_cliente, \n\ttre.nome_cliente, \n\ttre.categoria_produto \nfrom (\n\tselect \n\t\tcod_cliente, \n\t\tnome_cliente, \n\t\tcategoria_produto \n\tfrom pedidos p \n\twhere \n\t\tunidade = 'GM Maceio' and categoria_produto in ('CHAPARIA ESPELHO','TEMPERADO','TEMPERADO ESPECIAL')\n\t\tand data_pedido::date between date_trunc('month', CURRENT_DATE) - interval '4 months' and date_trunc('month', CURRENT_DATE) - interval '1 month' - interval '1 day'\n\tgroup by cod_cliente, nome_cliente, categoria_produto \n) tre\nleft join (\n\tselect \n\t\tcod_cliente, \n\t\tnome_cliente, \n\t\tcategoria_produto \n\tfrom pedidos p \n\twhere \n\t\tunidade = 'GM Maceio' and categoria_produto in ('CHAPARIA ESPELHO','TEMPERADO','TEMPERADO ESPECIAL')\n\t\tand data_pedido::date between date_trunc('month', CURRENT_DATE) - interval '1 month' and date_trunc('month', CURRENT_DATE) - interval '1 day'\n\tgroup by cod_cliente, nome_cliente, categoria_produto \n) n on tre.cod_cliente = n.cod_cliente\nwhere n.cod_cliente is null",
        "options": {}
      },
