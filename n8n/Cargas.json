    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n    unidade, \n    TO_CHAR(data_hora_entregue::DATE,'YYYY-MM-DD') as data, \n    max(carga::numeric) as carga,\n    concat(unidade,carga::numeric) as key\nfrom entregas e \nwhere \n    carga is not null and unidade = '{{ $('Edit Fields').item.json.unidade }}'\n    and data_hora_entregue::TIMESTAMP >= (now()::date - '20 minute'::interval)\ngroup by concat(unidade,carga::numeric), unidade, TO_CHAR(data_hora_entregue::DATE,'YYYY-MM-DD')",
        "options": {}
