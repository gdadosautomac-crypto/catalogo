    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tu.matriz, \n\teg.unidade, \n\tcategoria_produto, \n\tclasse_produto, \n\tsub_classe_produto, \n\tround(sum(valor_entregue + coalesce(acrescimo, 0) ), 2) as valor, \n\tROUND(sum(replace(metragem_entregue, ',','.')::numeric), 2) as m2\nfrom entregas_geral eg \n    left join unidades u on eg.tipo_unidade = u.tipo_unidade and eg.unidade = u.unidade \nwhere \n    eg.tipo_unidade = 'Bodinho' and u.matriz in ('4D Vidros','VITORIA DE SANTO ANTAO') \n    and data_hora_entregue::date between TO_CHAR(NOW()::DATE - interval '1 month', 'yyyy-mm-01')::date and (TO_CHAR(NOW()::DATE, 'yyyy-mm-01')::date - interval '1 second')\n    --and eg.data_hora_entregue::date between '2024-09-01' and '2024-09-30'\ngroup by u.matriz, eg.unidade, categoria_produto, classe_produto, sub_classe_produto",
        "options": {}
      },
