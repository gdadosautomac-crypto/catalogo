    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select * from (\n\tselect \n\t\tx.rota, \n\t\tx.categoria,\n\t\tSUM(m2_faltante) as Metragem, SUM(peso_faltante) as peso \n\tfrom (\n\t\tselect \n\t\t\trom.NU_PVE, \n\t\t\trom.NU_DPV, \n\t\t\trom.NU_PRO, \n\t\t\trota.DS_ROT as rota, \n\t\t\tcat.DS_CAT as Categoria, \n\t\t\t(pve.QT_PRO - coalesce(rom.qtd_exp,0)) as qtd_pendente, ((pve.QT_PRO - coalesce(rom.qtd_exp,0)) * pro.FAT_CONV1 ) as m2_faltante,\n\t\t\t((pve.QT_PRO - coalesce(rom.qtd_exp,0)) * pro.FAT_CONV2 ) as peso_faltante\n\t\tfrom mgpve01011 pve \n\t\t\tleft join (\n\t\t\t\tselect \n\t\t\t\t\trom.NU_PVE, \n\t\t\t\t\trom.NU_DPV, \n\t\t\t\t\trom.NU_PRO, \n\t\t\t\t\tSUM(rom.QT_PRO) as qtd_exp\n\t\t\t\tfrom mgrom01011 rom \n\t\t\t\twhere ID_TP_PED = 1\n\t\t\t\tgroup by ROM.NU_PVE, ROM.NU_DPV, ROM.NU_PRO\n\t\t\t) rom on rom.NU_DPV = pve.NU_DPV \n\t\t\tleft join mgpve01010 pver on pver.NU_PVE = pve.NU_PVE\n\t\t\tleft join mgpro01010 pro on pro.NU_PRO = pve.NU_PRO\n\t\t\tleft join mgcat01010 cat on cat.NU_CAT = pro.NU_CAT\n\t\t\tleft join mgcli01010 cli on cli.NU_CLI = pver.NU_CLI \n\t\t\tleft join mgrot01010 rota on rota.NU_ROT = cli.NU_ROT \n\t\twhere \n\t\t\t(pve.QT_PRO - coalesce(rom.qtd_exp,0)) > 0 and pver.ID_STATUS in (1,2) and pver.ID_TP_PED = '1'\n\t) x \n\tgroup by x.rota, x.categoria\n\tunion all \n\tselect \n\t\tRota,\n\t\tcase\n\t\t\twhen (categoria like ('%TEMPERADO%') and coes like ('%PADR%')) then 'ENGENHARIA PADRÃO'\n\t\t\telse categoria \n\t\tend as categoria,\n\t\tsum(M2) as metragem,\n\t\tsum(M2 * peso) as peso  \n\tfrom (\n\t\tselect\n\t\t\trota.DS_ROT as Rota,\n\t\t\tpedido.NU_PVE as Pedido,\n\t\t\tcategoria.DS_CAT as categoria,\n\t\t\tcoes.DS_OES as coes,\n\t\t\tproduto.DS_PRO,\n\t\t\tapontamento.NU_PECA as PECA,\n\t\t\tapontamento.SEQ_PECA as SEQ,\n\t\t\tmax(apontamento.dt_ins) as Apontamento,\n\t\t\tmax(ordempecas.QT_ALTURA) as Altura,\n\t\t\tmax(ordempecas.QT_LARGURA) as Largura,\n\t\t\tmax(ordempecas.qt_metrag) as M2,\n\t\t\tmax(classe.DS_CLP) as Classe,\n\t\t\tmax(subclasse.DS_SCP) as SubClasse,\n\t\t\tproduto.FAT_CONV2 as peso\n\t\tfrom mgwkf01010 apontamento\n\t\t\tleft join mgorf01012 pecaordem on (pecaordem.NU_OF = apontamento.NU_OF and pecaordem.NU_PECA = apontamento.NU_PECA and pecaordem.SEQ_PECA = apontamento.SEQ_PECA)\n\t\t\tleft join mgorf01010 ordem on (ordem.NU_OF = pecaordem.NU_OF)\n\t\t\tleft join mgpve01010 pedido on (pedido.NU_PVE = ordem.NU_PVE)\n\t\t\tleft join mgset01010 setor on (setor.NU_SET = apontamento.NU_SET)\n\t\t\tleft join mgorf01011 ordempecas on (ordempecas.NU_OF = ordem.NU_OF and ordempecas.NU_PECA = apontamento.NU_PECA)\n\t\t\tleft join mgset01010 proxsetor on (proxsetor.NU_SET = pecaordem.PROXIMO_SET)\n\t\t\tleft join mgpro01010 produto on (produto.NU_PRO = ordempecas.NU_PRO)\n\t\t\tleft join mgcat01010 categoria on (categoria.NU_CAT = produto.NU_CAT)\n\t\t\tleft join mgclp01010 classe on (classe.NU_CLP = produto.NU_CLP)\n\t\t\tleft join mgscp01010 subclasse on (subclasse.NU_SCP = produto.NU_SCP)\n\t\t\tleft join mgoes01010 coes on (coes.NU_OES = pedido.NU_OES)\n\t\t\tleft join mgcli01010 cliente on (cliente.NU_CLI = pedido.NU_CLI)\n\t\t\tleft join mgrot01010 rota on (rota.NU_ROT = cliente.NU_ROT)\n\t\t\tleft join mgpve01016 romaneio on romaneio.SEQ_PECA = apontamento.SEQ_PECA and romaneio.NU_PECA = apontamento.NU_PECA \n\t\twhere \n\t\t\tproxsetor.DS_SET is null and pedido.ID_TP_PED = '2'and pedido.NU_PVE != '0'\n\t\t\tand romaneio.NU_ROM is null\n\t\tgroup by apontamento.NU_PECA, apontamento.SEQ_PECA\n\t\torder by subclasse.DS_SCP asc, classe.DS_CLP asc, apontamento.NU_PECA asc, apontamento.SEQ_PECA asc \n\t) x \n\tgroup by rota, \n\tcase \n\t\twhen(categoria like ('%TEMPERADO%') and coes like ('%PADR%')) then 'ENGENHARIA PADRÃO' \n\t\telse categoria \n\tend \n)\nx order by rota asc ",
        "options": {}
      },
