        "operation": "executeQuery",
        "query": "-- devolução de pedidos\nSELECT \n\ttipo_unidade ,\n\tunidade,\n\tnome_cliente ,\n\tcod_pedido ,\n\tcoes ,\n\tdata_pedido ,\n\tdata_devolucao ,\n\tclasse_produto ,\n\tsub_classe_produto ,\n\tcategoria_produto ,\n\tclasse_produto ,\n\tDATE(dd.data_devolucao ::timestamp) AS data_devolucao,\n\tcusto_devolvido ,\n\tlucrodevolvido ,\n\tfaturamento_devolvido ,\n\tqtd_devolvida \nFROM \n    dre_devolucoes dd \nWHERE\n    DATE(data_devolucao ::timestamp) BETWEEN CURRENT_DATE - INTERVAL '1 day' AND CURRENT_DATE",
        "options": {}
