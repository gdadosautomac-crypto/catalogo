    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tmatriz,\n\tCONCAT('R$ ', TOTAL) as TOTAL\nfrom (\n\tselect \n\t\tu.matriz,\n\t\tROUND(SUM(replace(valor_titulo,',','.')::numeric),2) as Total \n\tfrom painel_financeiro pf \n\t\tleft join unidades u on pf.unidade = u.unidade \n\twhere \n\t\tpf.tipo_unidade = 'Bodinho' and tipo_documento = 'Dinheiro' \n\t\tand u.ativo = 'S'\n\tGROUP BY U.MATRIZ\n\torder by ROUND(SUM(replace(valor_titulo,',','.')::numeric),2) desc\n) X",
        "options": {}
      },
