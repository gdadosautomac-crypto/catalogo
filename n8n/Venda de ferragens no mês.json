    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tunidade,\n\tvendedor,\n\tvendidopolimero,\n\tCONCAT(ROUND(\n\t\tcase \n\t\t\twhen custopolimero = 0 then 0\n\t\t\telse abs(custopolimero/vendidopolimero - 1)\n\t\tend * 100 , 2), ' %')   as margempolimero,\n\tvendidometal,\n\tCONCAT(ROUND(\n\t\tcase \n\t\t\twhen custometal = 0 then 0\n\t\t\telse abs(custometal/vendidometal - 1)\n\t\tend * 100 , 2), ' %')   as margemmetal\nfrom (\n\tselect \n\t\tunidade, \n\t\tvendedor,\n\t\tROUND(SUM(\n\t\t\tcase \n\t\t\t\twhen classe_produto like ('POL%') or classe_produto = 'ZAMAC' then replace(p.valor_unitario_total_com_desconto,',','.')::numeric \n\t\t\t\telse 0\n\t\t\tend),2) as VendidoPolimero,\n\t\tROUND(SUM(\n\t\t\tcase \n\t\t\t\twhen classe_produto like ('POL%') or classe_produto = 'ZAMAC' then replace(p.custo_unitario_total_produto,',','.')::numeric \n\t\t\t\telse 0\n\t\t\tend),2) as CustoPolimero,\n\t\tROUND(SUM(\n\t\t\tcase \n\t\t\t\twhen classe_produto like ('METAL%') then replace(p.valor_unitario_total_com_desconto,',','.')::numeric \n\t\t\t\telse 0\n\t\t\tend),2) as VendidoMetal,\n\t\tROUND(SUM(\n\t\t\tcase \n\t\t\t\twhen classe_produto like ('METAL%') then replace(p.custo_unitario_total_produto,',','.')::numeric \n\t\t\t\telse 0\n\t\t\tend),2) as CustoMetal,\n\t\tROUND(SUM(\n\t\t\tcase \n\t\t\t\twhen classe_produto like ('POL%') or classe_produto = 'ZAMAC' or classe_produto like ('METAL%') then replace(p.valor_unitario_total_com_desconto,',','.')::numeric \n\t\t\t\telse 0\n\t\t\tend),2) as VendidoTotal\n\tfrom pedidos p \n\t\tleft join coes c on p.coes = c.nome \n\twhere \n\t\tdata_pedido >= to_char(NOW()::dATE, 'yyyy-mm-01')::date and c.gerafaturamento = 'SIM' and categoria_produto = 'FERRAGEM' \n\tgroup by unidade, vendedor\n) x \norder by unidade, vendidototal desc ",
        "options": {}
      },
