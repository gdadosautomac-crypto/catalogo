    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tcategoria_produto, \n\tcase \n\t\twhen categoria_produto like '%TEMPERADO%' then 'TEMPERADO' \n\t\twhen categoria_produto like '%BOX%' then 'BOX' \n\t\telse 'OUTROS' \n\tend Categoria, \n\tround(sum(valor_entregue + coalesce(acrescimo, 0) ), 2) as Valor, \n\tROUND(sum(replace(metragem_entregue, ',','.')::numeric), 2) as M2, \n\tROUND(sum(replace(peso_entregue, ',','.')::numeric), 2) as KG \nfrom entregas_geral eg \nwhere \n\tunidade = 'VITORIA DE SANTO ANTAO' \n\tand data_hora_entregue::date between date_trunc('MONTH', current_date) - interval '1 MONTH' \n\tand date_trunc('MONTH', current_date) - interval '1 SECOND' \ngroup by categoria_produto",
        "options": {}
