    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\tu.matriz, \n    eg.unidade, \n\tvendedor, \n\teg.categoria_produto, \n\tROUND(sum(case \n\t\twhen categoria_produto in ('TEMPERADO','TEMPERADO ESPECIAL','ENG PADRAO','ENG PADRÃO','TEMPERADO','TEMPERADO ESPECIAL','TEMPERADO PADRÃO') then replace(metragem_entregue,',','.')::numeric * 2 \n\t\twhen categoria_produto in ('BOX COM AVARIA','BOX PADRÃO','BOX PADRAO 1900','BOX PADRÃO 1900','BOX PADRÃO/ JANELA PADRÃO') then replace(metragem_entregue,',','.')::numeric * 1 \n\t\telse (valor_entregue + coalesce(acrescimo, 0)) * 0.01 \n\tend),2) as comissao \n\t--round(sum(valor_entregue + coalesce(acrescimo, 0)),2) * 0.01 as comissao\nfrom entregas_geral eg\n\tleft join unidades u on eg.unidade = u.unidade \nwhere \n\teg.tipo_unidade = 'Bodinho' \n    --and data_hora_entregue::date between '2024-08-01' and '2024-08-31'\n\tand data_hora_entregue::date between (now() - interval '1 month')::date and current_date - 1\ngroup by u.matriz, eg.unidade, vendedor, categoria_produto\norder by matriz asc, unidade asc",
        "options": {}
      },
