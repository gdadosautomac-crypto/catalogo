    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n\tpc.tipo_unidade, \n\tpc.unidade,\n\tpc.data_pedido::date, \n\tpc.pedido,\n\tpc.fornecedor, \n\tROUND(MAX(replace(pc.valor_total_pedido,',','.')::numeric),2) as ValorPedido, \n\tpc.previsao_entrega::date,\n\t(pc.previsao_entrega::date - NOW()::DATE) as Dias_em_Atraso\nfrom pedidos_compras pc \nleft join unidades u on pc.unidade = u.unidade \nwhere \n\tpc.status = '1' and u.ativo = 'S' and pc.unidade in ('Alumiaco Recife','GM Recife', 'OLINDA', 'GM MONTESE')\ngroup by pc.unidade, pc.data_pedido::date, pc.pedido, pc.fornecedor, pc.previsao_entrega::date, pc.tipo_unidade",
        "options": {}
