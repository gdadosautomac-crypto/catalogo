    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select \n\ts.tipo_unidade, \n\ts.unidade, \n\ts.id as cod_cliente, \n\ts.nome as cliente, \n\tround(sum(replace(s.total,',','.')::numeric), 2) as Saldo, \n\tmax(s.datasaldo::date)\nfrom saldo s\nwhere \n\ts.tipo_unidade = 'Tempera'and (\n    \t(s.unidade = '4D Vidros' AND s.id IN ('9252', '9434', '9317', '9387', '9393'))\n    \tOR (s.unidade = 'FORTALEZA' AND s.id IN ('1795', '109', '110'))\n    \tOR (s.unidade = 'INBRAVIDROS' AND s.id IN ('4689', '5140', '4846', '5035', '4877', '4811', '4810', '4885', '4851', '4979'))\n    \tOR (s.unidade = 'Oazem' AND s.id IN ('11229', '11416', '6840'))\n    \tOR (s.unidade = 'VITORIA DE SANTO ANTAO' AND s.id IN ('1009', '721', '1151', '1446', '1063', '1050', '1462', '293', '1', '799', '503', '1354', '1315'))\n\t)\ngroup by s.tipo_unidade, s.unidade, s.id, s.nome\norder by s.tipo_unidade desc, s.unidade asc",
        "options": {}
      },
