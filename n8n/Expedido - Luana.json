    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n\tu.tipo_unidade, \n\tu.unidade, \n\tu.razao_social, \n\t--eg.data_hora_entregue, \n\tCOALESCE(ROUND(SUM(eg.valor_entregue::NUMERIC), 2), 0) AS total_expedido \nFROM unidades u \n\tLEFT JOIN entregas_geral eg ON u.unidade = eg.unidade \nWHERE \n\t(DATE_PART('day', NOW()::DATE) = 1 AND \n\tEG.data_hora_entregue::DATE BETWEEN (DATE_TRUNC('MONTH', NOW()::DATE) - INTERVAL '1 MONTH') AND (DATE_TRUNC('MONTH', NOW()::DATE) - INTERVAL '1 DAY')) \n\tor \n\t(EG.data_hora_entregue::DATE BETWEEN DATE_TRUNC('MONTH', NOW()::DATE) AND NOW()::DATE)\n    -- EG.data_hora_entregue::DATE BETWEEN '2025-03-01' and '2025-03-31'\nGROUP BY u.tipo_unidade, u.unidade, u.razao_social --,eg.data_hora_entregue \nORDER BY u.razao_social DESC, total_expedido desc",
        "options": {}
      },
